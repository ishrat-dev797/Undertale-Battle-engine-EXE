{
  "name": "ut-battle-engine-test",
  "productName": "UT Battle Engine Test",
  "version": "1.0.0",
  "description": "UT Battle engine",
  "author": "Dumb_Artist05",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.dumbartist05.utbattleenginetest",
    "productName": "UT Battle Engine Test",
    "compression": "normal",
    "files": ["**/*", "!dist/**/*"],
    "win": {
      "target": "nsis",
      "icon": "build/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "UT Battle Engine Test",
      "installerIcon": "build/logo.ico",
      "uninstallerIcon": "build/logo.ico"
    }
  }
}